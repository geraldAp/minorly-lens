{
  "manifest_version": 3,
  "name": "Minorly Lens",
  "version": "0.1.0",
  "description": "Estimate provider fees, platform markup and how buyers and sellers cover them.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Minorly Lens — Fee calculator",
